	"Render the common bipartite author-paper topology with caller-supplied node presentation."
	aMondrian nodes
		stencil: aStencil;
		with: (papers asArray , authors asArray).
	authors do: [ :anAuthor |
		aMondrian edges
			connect: (anAuthor papers select: [ :aPaper | papers includes: aPaper ])
			from: [ :aPaper | anAuthor ]
			to: [ :aPaper | aPaper ] ].
	aMondrian layout custom: (GtGraphForceBasedLayout new
		charge: -2000;
		length: 200)! !!VSPaperGroup methodsFor: 'model' stamp: '9/2/2026 15:05'!authorPaperNodeFor: aModel highlightedPapers: highlightedPapers
	| isAuthor size tooltipText element isHighlightedPaper |
	isAuthor := aModel isKindOf: VSAuthor.
	isHighlightedPaper := (aModel isKindOf: VSPaper) and: [ highlightedPapers includes: aModel ].
	size := isAuthor ifTrue: [ 25 + (aModel papers size * 8) ] ifFalse: [ 25 + (aModel authors size * 8) ].
	tooltipText := isAuthor ifTrue: [ aModel name ] ifFalse: [ aModel record at: 'Title' ].
	element := BlElement new
		background: (isAuthor ifTrue: [ Color lightBlue ] ifFalse: [ isHighlightedPaper ifTrue: [ Color paleRed darker ] ifFalse: [ Color paleRed ] ]);
		geometry: (isAuthor ifTrue: [ BlRectangleGeometry new ] ifFalse: [ BlEllipseGeometry new ]);
		size: size @ size;
		addAptitude: (BrGlamorousWithLabelTooltipAptitude text: tooltipText);
		when: BlClickEvent do: [ :anEvent | anEvent currentTarget phlow spawnObject: aModel ];
		yourself.
	(aModel isKindOf: VSPaper) ifTrue: [ aModel isDesignStudy ifTrue: [ element border: (BlBorder paint: Color red width: 2) ] ].
	isAuthor ifTrue: [ element layout: BlFrameLayout new; addChild: (BlTextElement new text: (aModel name) asRopedText; constraintsDo: [ :aConstraints | aConstraints frame horizontal alignCenter. aConstraints frame vertical alignCenter ]) ].
	^ element! !!VSPaperGroup methodsFor: 'model' stamp: '9/2/2026 15:05'!reachableAuthorPaperGraphIn: aMondrian
	"Render all components reachable from my papers, emphasizing the original papers."
	| component papers authors highlightedPapers |
	component := self reachablePaperAuthorComponent.
	papers := component key.
	authors := component value.
	highlightedPapers := self items asIdentitySet.
	self renderAuthorPaperGraphIn: aMondrian papers: papers authors: authors nodeStencil: [ :aModel | self authorPaperNodeFor: aModel highlightedPapers: highlightedPapers ]! !!VSPaperGroup methodsFor: 'model' stamp: '9/2/2026 15:05'!reachablePaperAuthorComponent
	"Answer the union of the paper-author connected components of my papers."
	| papers authors pendingPapers aPaper |
	papers := self items asIdentitySet.
	authors := IdentitySet new.
	pendingPapers := OrderedCollection new addAll: self items; yourself.
	[ pendingPapers isEmpty ] whileFalse: [
		aPaper := pendingPapers removeFirst.
		aPaper authors do: [ :anAuthor |
			authors add: anAuthor.
			anAuthor papers do: [ :anotherPaper |
				(papers includes: anotherPaper) ifFalse: [ papers add: anotherPaper. pendingPapers add: anotherPaper ] ] ] ].
	^ papers -> authors! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!VSPaperGroup class	uses: TGtGroupWithItems classTrait	instanceVariableNames: 'items'!!VSPaperGroup class commentStamp: '' prior: 0!A moldable collection wrapper for papers in a visualization study.!Object subclass: #VSStudyExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!authorPaperGraph	<gtExample>	<return: #GtMondrian>	| aStudy aGraph designStudyPapers designStudyAuthors |	aStudy := VSStudy new.	designStudyPapers := aStudy allPapers values select: #isDesignStudy.	designStudyAuthors := (designStudyPapers flatCollect: #authors) asIdentitySet.	aGraph := GtMondrian new.	aStudy authorPaperGraphIn: aGraph.	self assert: aGraph topStep root graph nodeChildren size equals: designStudyPapers size + designStudyAuthors size.	self assert: aGraph topStep root graph edgeChildren size equals: (designStudyAuthors sum: [ :anAuthor | anAuthor papers count: [ :aPaper | designStudyPapers includes: aPaper ] ]).	^ aGraph! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!authorPaperGraphContainsOnlyDesignStudyPapers	<gtExample>	<return: #GtMondrian>	| aStudy aGraph paperModels authorModels |	aStudy := VSStudy new.	aGraph := self authorPaperGraph.	paperModels := aGraph nodeElements		collect: [ :each | each graph model ]		thenSelect: [ :each | each isKindOf: VSPaper ].	authorModels := aGraph nodeElements		collect: [ :each | each graph model ]		thenSelect: [ :each | each isKindOf: VSAuthor ].	self assert: (paperModels allSatisfy: #isDesignStudy).	self assert: (authorModels allSatisfy: [ :anAuthor | anAuthor papers anySatisfy: #isDesignStudy ]).	^ aGraph! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!authorsAreListedByName	<gtExample>	| aStudy authors |	aStudy := self study.	authors := aStudy authors values asSortedCollection: [ :anAuthor :anotherAuthor | anAuthor name < anotherAuthor name ].	self assert: authors size equals: aStudy authors size.	self assert: (authors allSatisfy: [ :anAuthor | anAuthor isKindOf: VSAuthor ]).	self assert: (authors allSatisfy: [ :anAuthor | anAuthor papers isNotEmpty ]).	^ aStudy! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperAuthorCounts	<gtExample>	| aStudy papers |	aStudy := self study.	papers := aStudy allPapers values.	self assert: (papers allSatisfy: [ :aPaper | aPaper authorNames size >= 0 ]).	self assert: (papers anySatisfy: [ :aPaper | aPaper authorNames size > 1 ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperGroupGroupsPapersByYear	<gtExample>	| paperGroup groups |	paperGroup := VSPaperGroup withAll: self study allPapers values.	groups := paperGroup groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ].	self assert: (groups at: '2015') class equals: VSPaperGroup.	self assert: (groups at: '2015') size equals: 31.	self assert: (groups values inject: 0 into: [ :sum :each | sum + each size ]) equals: paperGroup size.	^ groups! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperGroupReachableAuthorPaperGraph	<gtExample>	<return: #GtMondrian>	| aGroup component aGraph |	aGroup := self study papersMatchingTitle: 'polyptychon'.	component := aGroup reachablePaperAuthorComponent.	aGraph := GtMondrian new.	aGroup reachableAuthorPaperGraphIn: aGraph.	self assert: aGraph topStep root graph nodeChildren size equals: component key size + component value size.	self assert: aGraph topStep root graph edgeChildren size equals: (component value sum: [ :anAuthor | anAuthor papers count: [ :aPaper | component key includes: aPaper ] ]).	^ aGraph! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!papersAreNumberedAndSortedById	<gtExample>	| aStudy papers |	aStudy := self study.	papers := aStudy allPapers values		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ].	self assert: papers first id equals: '1'.	self assert: papers size equals: aStudy allPapers size.	self assert: (papers withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ]) first key equals: 1.	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!papersMatchingTitleReturnsAPaperGroup	<gtExample>	| aStudy matches |	aStudy := self study.	matches := aStudy papersMatchingTitle: 'polyptychon'.	self assert: matches class equals: VSPaperGroup.	self assert: matches size equals: 1.	self assert: matches first id equals: '305'.	^ matches! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!papersMatchingTitleReturnsPapersContainingTheQuery	<gtExample>	| aStudy matches |	aStudy := self study.	matches := aStudy papersMatchingTitle: 'polyptychon'.	self assert: matches size equals: 1.	self assert: matches first id equals: '305'.	self assert: (matches first record at: 'Title') equals: 'Polyptychon: A Hierarchically-Constrained Classified Dependencies Visualization'.	^ matches! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!selectedDesignStudyPapers	<gtExample>	| aStudy papers |	aStudy := self study.	papers := aStudy allPapers values select: [ :aPaper | aPaper isDesignStudy and: [ aPaper selectedRecord notNil ] ].	self assert: papers size equals: aStudy selectedPapers size.	self assert: (papers allSatisfy: [ :aPaper | aPaper isDesignStudy ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!selectedPaperTopics	<gtExample>	| papers |	papers := self selectedPapersAreNumberedAndSortedById collect: #value.	self assert: (papers allSatisfy: [ :aPaper | aPaper topicName = (aPaper selectedRecord at: 'Topic' ifAbsent: [ nil ]) ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!selectedPapersAreNumberedAndSortedById	<gtExample>	| aStudy papers |	aStudy := self study.	papers := (aStudy allPapers values select: [ :aPaper | aPaper isDesignStudy and: [ aPaper selectedRecord notNil ] ])		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ].	self assert: papers size equals: aStudy selectedPapers size.	self assert: (papers withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ]) first key equals: 1.	self assert: (papers allSatisfy: [ :aPaper | aPaper isDesignStudy ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!study	<gtExample>	| aStudy |	aStudy := VSStudy new.	self assert: aStudy allPapers size equals: 346.	self assert: aStudy selectedPapers size equals: 65.	^ aStudy! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperCountsByYearChart	<gtExample>	<return: #GtPlotterHorizontalBarChart>	| chart |	chart := self study paperCountsByYearChart.	self assert: chart class equals: GtPlotterHorizontalBarChart.	^ chart! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperCountsByYearChartAllBarsMapToPaperGroups	<gtExample>	| study chart paperGroups |	study := self study.	chart := study paperCountsByYearChart.	paperGroups := OrderedCollection new.	(chart instVarNamed: 'data') groupsDo: [ :eachPlotterGroup |		paperGroups add: (study paperGroupFromPlotterDataEntity: eachPlotterGroup) ].	self assert: paperGroups size equals: 24.	self assert: (paperGroups allSatisfy: [ :each | each isKindOf: VSPaperGroup ]).	self assert: (paperGroups select: [ :each | each size = 40 ]) size equals: 1.	^ chart! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperCountsByYearChartAllRenderedBarGroupsMapToPaperGroups	<gtExample>	| study chart paperGroups |	study := self study.	chart := study paperCountsByYearChart.	paperGroups := OrderedCollection new.	(chart instVarNamed: 'data') groupsDo: [ :eachPlotterGroup |		paperGroups add: (study paperGroupFromPlotterDataEntity: eachPlotterGroup) ].	self assert: paperGroups size equals: 24.	self assert: (paperGroups allSatisfy: [ :each | each isKindOf: VSPaperGroup ]).	self assert: (paperGroups at: 3) size equals: 40.	^ chart asElement! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperCountsByYearChartBarsHavePaperGroups	<gtExample>	| chart data |	chart := self study paperCountsByYearChart.	data := chart instVarNamed: 'data'.	self assert: (data values allSatisfy: [ :each | each third isKindOf: VSPaperGroup ]).	^ chart! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperCountsByYearChartBarsRetainPaperGroups	<gtExample>	| chart chartElement |	chart := self study paperCountsByYearChart.	chartElement := chart asElement.	self assert: chartElement children notEmpty.	^ chartElement! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperGroupsByYear	<gtExample>	| groups |	groups := (VSPaperGroup withAll: self study allPapers values)		groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ].	self assert: (groups at: '2015') class equals: VSPaperGroup.	self assert: (groups at: '2015') size equals: 31.	self assert: (groups values inject: 0 into: [ :sum :each | sum + each size ]) equals: 346.	^ groups! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!papersInYearReturnsAllPapers	<gtExample>	| papers |	papers := self study papersInYear: 2015 selectedOnly: false.	self assert: papers class equals: VSPaperGroup.	self assert: papers size equals: 31.	self assert: (papers allSatisfy: [ :each | (each record at: 'Paper Year') = '2015' ]).	^ papers! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!papersInYearReturnsSelectedPapers	<gtExample>	| papers |	papers := self study papersInYear: 2015 selectedOnly: true.	self assert: papers class equals: VSPaperGroup.	self assert: papers size equals: 10.	self assert: (papers allSatisfy: [ :each |		(each record at: 'Paper Year') = '2015'			and: [ each selectedRecord notNil ] ]).	^ papers! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraphDoesNotEmptyPaperGroup	<gtExample>	| group originalItems graph |	group := ((VSPaperGroup withAll: self study allPapers values)		groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) at: '2015'.	originalItems := group items asArray.	graph := GtMondrian new.	group reachableAuthorPaperGraphIn: graph.	self assert: group size equals: originalItems size.	self assert: group items asArray equals: originalItems.	^ graph! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!selectedPaperGroupsByYear	<gtExample>	| groups |	groups := (VSPaperGroup withAll: (self study allPapers values select: [ :aPaper | aPaper selectedRecord notNil ]))		groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ].	self assert: (groups at: '2015') class equals: VSPaperGroup.	self assert: (groups at: '2015') size equals: 10.	self assert: (groups values inject: 0 into: [ :sum :each | sum + each size ]) equals: 65.	^ groups! !Object subclass: #VSTopicExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSTopicExamples commentStamp: '' prior: 0!Examples for topic relationships in a visual software study.!!VSTopicExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!topicPrintsItsName	<gtExample>	| aStudy aTopic |	aStudy := VSStudy new.	aTopic := aStudy topicNamed: 'Elements'.	self assert: aTopic printString equals: aTopic name.	^ aTopic! !Object subclass: #VSAuthorExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSAuthorExamples commentStamp: '' prior: 0!Examples for the author relationships in a visual software study.!!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!authorPapersAreSortedAndNumbered	<gtExample>	| anAuthor papers |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	papers := anAuthor papers		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ].	self assert: papers size equals: anAuthor papers size.	self assert: (papers allSatisfy: [ :aPaper | aPaper authors includes: anAuthor ]).	self assert: (papers withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ]) first key equals: 1.	^ anAuthor! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!authorPrintsItsName	<gtExample>	| anAuthor |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	self assert: anAuthor printString equals: anAuthor name.	^ anAuthor! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraph	<gtExample>	<return: #GtMondrian>	| anAuthor aGraph |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	aGraph := GtMondrian new.	anAuthor reachableAuthorPaperGraphIn: aGraph.	self assert: aGraph topStep root graph nodeChildren size > anAuthor papers size.	self assert: aGraph topStep root graph edgeChildren size > 0.	^ aGraph! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraphDoesNotModifyStartingAuthorPapers	<gtExample>	<return: #GtMondrian>	| anAuthor originalPapers aGraph |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	originalPapers := anAuthor papers copy.	aGraph := GtMondrian new.	anAuthor reachableAuthorPaperGraphIn: aGraph.	self assert: anAuthor papers equals: originalPapers.	^ aGraph! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraphHighlightsStartingAuthor	<gtExample>	<return: #BlElement>	| anAuthor aNode |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	aNode := anAuthor authorPaperNodeFor: anAuthor.	self assert: aNode background paint color equals: Color lightBlue darker.	^ aNode! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!studyCreatesUniqueAuthorsAndLinksPapers	<gtExample>	| aStudy aPaper anAuthor |	aStudy := VSStudy new.	aPaper := aStudy paperAt: '1'.	anAuthor := aStudy authorNamed: 'Sajaniemi, J.'.	self assert: anAuthor class equals: VSAuthor.	self assert: (aStudy authorNamed: 'Sajaniemi, J.') equals: anAuthor.	self assert: (aStudy authorNamed: 'Sajaniemi, J.') == anAuthor.	self assert: (anAuthor papers includes: aPaper).	^ anAuthor! !!VSAuthorExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!initialsForMalformedOrIncompleteNamesAreSafe	<gtExample>	| anAuthor |	anAuthor := VSAuthor new name: 'Plato'; yourself.	self assert: (anAuthor initialsFor: anAuthor) equals: 'P'.	^ anAuthor! !Object subclass: #VSPaperExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!authorGraphLabelsUseGivenThenSurnameInitial	<gtExample>	| aPaper anAuthor |	aPaper := self paperAuthorsAreLinkedToAuthorInstances.	anAuthor := aPaper authors detect: [ :each | each name = 'Daniel, D.T.' ].	self assert: (aPaper initialsForAuthor: anAuthor) equals: 'DD'.	^ anAuthor! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!designStudyPaperGraphNodeHasRedBorder	<gtExample>	<return: #BlElement>	| aPaper aNode |	aPaper := self designStudyReceivesSelectedRecord.	aNode := aPaper authorPaperNodeFor: aPaper.	self assert: aNode border paint color equals: Color red.	self assert: aNode border width equals: 2.	^ aNode! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!designStudyReceivesSelectedRecord	<gtExample>	| aStudy designStudy |	aStudy := VSStudy new.	designStudy := aStudy allPapers values		detect: [ :each | each isDesignStudy and: [ each selectedRecord notNil ] ].	self		assert: (designStudy selectedRecord at: 'ID')		equals: designStudy id.	^ designStudy! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!nonDesignStudyHasNoStudyDetails	<gtExample>	| aStudy aPaper |	aStudy := VSStudy new.	aPaper := aStudy allPapers values detect: [ :each | each isDesignStudy not ].	self assert: aPaper selectedRecord isNil.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperAuthorNamesFollowAuthorAttributeOrder	<gtExample>	| aPaper |	aPaper := self paperPrintsItsTitle.	self assert: aPaper authorNames first equals: 'Daniel, D.T.'.	self assert: (aPaper authorNames at: 2) equals: 'Wuchner, E.'.	self assert: (aPaper authorNames at: 3) equals: 'Sokolov, K.'.	self assert: (aPaper authorNames at: 4) equals: 'Stal, M.'.	self assert: (aPaper authorNames at: 5) equals: 'Liggesmeyer, P.'.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperAuthorsAreLinkedToAuthorInstances	<gtExample>	| aPaper authors |	aPaper := self paperPrintsItsTitle.	authors := aPaper authors.	self assert: authors size equals: aPaper authorNames size.	self assert: (authors allSatisfy: [ :anAuthor | anAuthor isKindOf: VSAuthor ]).	self assert: (authors allSatisfy: [ :anAuthor | anAuthor papers includes: aPaper ]).	self assert: (authors allSatisfy: [ :anAuthor | anAuthor papers size > 0 ]).	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperGoogleScholarSearchUrlUsesItsTitle	<gtExample>	| aPaper |	aPaper := self designStudyReceivesSelectedRecord.	self		assert: aPaper googleScholarSearchUrl		equals: 'https://scholar.google.com/scholar?hl=en&q=' , (aPaper record at: 'Title') urlEncoded.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperPrintsItsTitle	<gtExample>	| aPaper |	aPaper := self designStudyReceivesSelectedRecord.	self assert: aPaper printString equals: (aPaper record at: 'Title').	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperSummaryContainsAllRecordAttributes	<gtExample>	| aPaper |	aPaper := self paperPrintsItsTitle.	self assert: aPaper record associations size equals: aPaper record keys size.	self assert: (aPaper record includesKey: 'Title').	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!paperSummaryOrdersTitleAndAuthorsAndHidesNumericAttributes	<gtExample>	| aPaper authorKeys otherKeys orderedKeys |	aPaper := self paperPrintsItsTitle.	authorKeys := #(		'First Author'		'Second Author'		'Third Author'		'Fourth Author'		'Fifth Author'		'Sixth Author'		'Seven Author'		'Eighth Author'		'Nineth Author'		'Tenth Author'		'Eleventh Author'		'Twelfth Author').	otherKeys := aPaper record keys reject: [ :aKey |		(aKey allSatisfy: [ :aCharacter | aCharacter isDigit ])			or: [ aKey = 'Title' or: [ authorKeys includes: aKey ] ] ].	orderedKeys := { 'Title' }		, (authorKeys select: [ :aKey | aPaper record includesKey: aKey ])		, otherKeys asSortedCollection.	self assert: orderedKeys first equals: 'Title'.	self assert: (orderedKeys includes: '1') equals: false.	self assert: (orderedKeys indexOf: 'First Author') < (orderedKeys indexOf: 'Second Author').	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraph	<gtExample>	<return: #GtMondrian>	| aPaper aGraph reachablePapers reachableAuthors pendingPapers aReachablePaper |	aPaper := self paperAuthorsAreLinkedToAuthorInstances.	reachablePapers := IdentitySet with: aPaper.	reachableAuthors := IdentitySet new.	pendingPapers := OrderedCollection with: aPaper.	[ pendingPapers isEmpty ] whileFalse: [		aReachablePaper := pendingPapers removeFirst.		aReachablePaper authors do: [ :anAuthor |			reachableAuthors add: anAuthor.			anAuthor papers do: [ :anotherPaper |				(reachablePapers includes: anotherPaper) ifFalse: [					reachablePapers add: anotherPaper.					pendingPapers add: anotherPaper ] ] ] ].	aGraph := GtMondrian new.	aPaper reachableAuthorPaperGraphIn: aGraph.	self assert: aGraph topStep root graph nodeChildren size equals: reachablePapers size + reachableAuthors size.	self assert: aGraph topStep root graph edgeChildren size equals: (reachableAuthors sum: [ :anAuthor | anAuthor papers size ]).	^ aGraph! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!selectedPaperHasStudyDetails	<gtExample>	| aPaper |	aPaper := self designStudyReceivesSelectedRecord.	self assert: aPaper isDesignStudy.	self assert: aPaper selectedRecord isNotNil.	self assert: aPaper selectedRecord associations isNotEmpty.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:00'!studyCreatesPapersKeyedById	<gtExample>	| aStudy aPaper |	aStudy := VSStudy new.	self assert: aStudy allPapers size equals: 346.	aPaper := aStudy paperAt: '1'.	self assert: aPaper class equals: VSPaper.	self assert: aPaper study equals: aStudy.	self assert: aPaper id equals: '1'.	^ aStudy! !!VSPaperExamples methodsFor: 'Examples' stamp: '9/2/2026 15:00'!paperTitleIsAvailableThroughAnAccessor	<gtExample>	| aPaper |	aPaper := self paperPrintsItsTitle.	self assert: aPaper title equals: (aPaper record at: 'Title').	^ aPaper! !