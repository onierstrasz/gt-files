Object subclass: #VSStudy	instanceVariableNames: 'allPapers selectedPapers authors topics'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!allPapers	^ allPapers! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!authorNamed: aName	^ authors		at: aName		ifAbsentPut: [ VSAuthor new			name: aName;			yourself ]! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!authors	^ authors! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!paperAt: anId	^ allPapers at: anId! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!selectedPapers	^ selectedPapers! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!topicNamed: aName	^ topics		at: aName		ifAbsentPut: [ VSTopic new			name: aName;			yourself ]! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:00'!topics	^ topics! !!VSStudy methodsFor: 'graphing' stamp: '9/2/2026 15:00'!authorPaperGraphIn: aMondrian	"Visualize only Design Study papers and authors of those papers."	| designStudyPapers designStudyAuthors |	designStudyPapers := self allPapers values select: #isDesignStudy.	designStudyAuthors := (designStudyPapers flatCollect: #authors) asIdentitySet.	(VSPaperGroup withAll: designStudyPapers)		renderAuthorPaperGraphIn: aMondrian		papers: designStudyPapers		authors: designStudyAuthors		nodeStencil: [ :aModel | self authorPaperNodeFor: aModel ]! !!VSStudy methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!authorPaperNodeFor: aModel	| isAuthor size tooltipText element |	isAuthor := aModel isKindOf: VSAuthor.	size := isAuthor		ifTrue: [ 25 + (aModel papers size * 8) ]		ifFalse: [ 25 + (aModel authors size * 8) ].	tooltipText := isAuthor		ifTrue: [ aModel name ]		ifFalse: [ aModel record at: 'Title' ].	element := BlElement new		background: (isAuthor ifTrue: [ Color lightBlue ] ifFalse: [ Color paleRed ]);		geometry: (isAuthor ifTrue: [ BlRectangleGeometry new ] ifFalse: [ BlEllipseGeometry new ]);		size: size @ size;		addAptitude: (BrGlamorousWithLabelTooltipAptitude text: tooltipText);		when: BlClickEvent do: [ :anEvent | anEvent currentTarget phlow spawnObject: aModel ];		yourself.	isAuthor		ifTrue: [			element				layout: BlFrameLayout new;				addChild: (BlTextElement new					text: (self initialsForAuthor: aModel) asRopedText;					constraintsDo: [ :aConstraints |						aConstraints frame horizontal alignCenter.						aConstraints frame vertical alignCenter ]) ]		ifFalse: [ aModel isDesignStudy ifTrue: [ element border: (BlBorder paint: Color red width: 2) ] ].	^ element! !!VSStudy methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!gtAuthorPaperGraphFor: aView	<gtView>	^ aView mondrian		title: 'Design study author papers graph';		priority: 10;		painting: [ :aMondrian | self authorPaperGraphIn: aMondrian ];		actionUpdateButton! !!VSStudy methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!initialsForAuthor: anAuthor	"Answer initials for author names formatted as 'Surname, Given names'."	| nameParts surname givenNames givenLetters surnameLetters |	nameParts := anAuthor name substrings: ','.	surname := nameParts first ifNil: [ '' ].	givenNames := nameParts allButFirst joinUsing: ' '.	givenLetters := givenNames select: #isLetter.	surnameLetters := surname select: #isLetter.	^ (givenLetters		ifEmpty: [ '' ]		ifNotEmpty: [ givenLetters first asString ])		, (surnameLetters			ifEmpty: [ '' ]			ifNotEmpty: [ surnameLetters first asString ])! !!VSStudy methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtAuthorsFor: aView	<gtView>	^ aView columnedList		title: 'Authors';		priority: 3;		items: [ self authors values asSortedCollection: [ :anAuthor :anotherAuthor | anAuthor name < anotherAuthor name ] ];		column: 'Author' text: [ :anAuthor | anAuthor name ] weight: 2;		column: '# of papers' text: [ :anAuthor | anAuthor papers size ] weight: 0.6;		send: [ :anAuthor | anAuthor ];		actionUpdateButton! !!VSStudy methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtPapersFor: aView	<gtView>	^ aView columnedList		title: 'Papers';		priority: 1;		items: [ (allPapers values			sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtSelectedPapersFor: aView	<gtView>	^ aView columnedList		title: 'Selected Papers';		priority: 2;		items: [ ((allPapers values select: [ :aPaper | aPaper isDesignStudy and: [ aPaper selectedRecord notNil ] ])			sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: 'Topic' text: [ :anAssociation | anAssociation value topicName ifNil: [ '' ] ] weight: 1;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'views' stamp: '9/2/2026 15:00'!gtPaperCountsByYearFor: aView	<gtView>	^ aView explicit		title: 'Papers by year';		priority: 2.3;		stencil: [ self paperCountsByYearChart asElement ];		actionUpdateButton! !!VSStudy methodsFor: 'views' stamp: '9/2/2026 15:00'!gtPaperGroupsByYearFor: aView	<gtView>	^ aView columnedList		title: 'Paper groups by year';		priority: 2.1;		items: [			((VSPaperGroup withAll: allPapers values)				groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) associations				sorted: [ :anAssociation :anotherAssociation | anAssociation key < anotherAssociation key ] ];		column: 'Year' text: [ :anAssociation | anAssociation key ];		column: '# of papers' text: [ :anAssociation | anAssociation value size ];		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'views' stamp: '9/2/2026 15:00'!gtSelectedPaperGroupsByYearFor: aView	<gtView>	^ aView columnedList		title: 'Selected paper groups by year';		priority: 2.2;		items: [			((VSPaperGroup withAll: (allPapers values select: [ :aPaper | aPaper selectedRecord notNil ]))				groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) associations				sorted: [ :anAssociation :anotherAssociation | anAssociation key < anotherAssociation key ] ];		column: 'Year' text: [ :anAssociation | anAssociation key ];		column: '# of papers' text: [ :anAssociation | anAssociation value size ];		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'gt-search' stamp: '9/2/2026 15:00'!gtSpotterForPaperTitles: aSearch	<gtSearch>	^ aSearch list		title: 'Paper titles';		priority: 10;		items: [ self allPapers values ];		itemsLimit: Float infinity;		itemName: [ :aPaper | aPaper record at: 'Title' ];		sendCategory: [ :aCategory :aStep :thisSearch |			VSPaperGroup withAll: aCategory items contents asArray ];		filterBySubstring! !!VSStudy methodsFor: 'initialization' stamp: '9/2/2026 15:00'!initialize	super initialize.	self loadFromResources! !!VSStudy methodsFor: 'initialization' stamp: '9/2/2026 15:00'!loadFromResources	| dataFolder allPaperRecords selectedPapersById |	dataFolder := FileLocator gtResource / 'onierstrasz' / 'gt-vissoft2026' / 'data'.	allPaperRecords := (CSV2JSON for: (dataFolder / 'dataset-review-vissoft-all.csv') contents) jsonObject.	selectedPapers := (CSV2JSON for: (dataFolder / 'dataset-review-vissoft-selected.csv') contents) jsonObject.	selectedPapersById := Dictionary new.	selectedPapers do: [ :each | selectedPapersById at: (each at: 'ID') put: each ].	allPapers := Dictionary new.	authors := Dictionary new.	topics := Dictionary new.	allPaperRecords do: [ :each |		| paper |		paper := VSPaper new			study: self;			record: each;			yourself.		paper isDesignStudy ifTrue: [			paper selectedRecord: (selectedPapersById at: paper id ifAbsent: [ nil ]) ].		paper authorNames do: [ :eachName | (self authorNamed: eachName) addPaper: paper ].		paper topic ifNotNil: [ :aTopic | aTopic addPaper: paper ].		allPapers at: paper id put: paper ].	^ self! !!VSStudy methodsFor: 'charting' stamp: '9/2/2026 15:00'!paperCountsByYearChart	| years data maximumCount widthScale heightScale chart |	years := (allPapers values collect: [ :aPaper | aPaper record at: 'Paper Year' ]) asSet		asSortedCollection.	data := GtPlotterDataGroup new values: (years flatCollect: [ :aYear |		{			{ aYear. false. self papersInYear: aYear selectedOnly: false }.			{ aYear. true. self papersInYear: aYear selectedOnly: true } } ]).	data := data		groupedBy: [ :each | each first ]		sorted: [ :a :b | a key < b key ]		labelled: #yourself.	data := data		groupedBy: [ :each | each second ]		sorted: [ :a :b | a key not ]		colored: [ :isSelected |			isSelected				ifTrue: [ Color r: 244 g: 204 b: 204 range: 255 ]				ifFalse: [ Color r: 173 g: 216 b: 230 range: 255 ] ].	maximumCount := data inject: 0 intoValues: [ :maximum :each |		maximum max: each third size ].	widthScale := GtPlotterLinearScale new domainFrom: 0 to: maximumCount.	heightScale := GtPlotterLinearScale new		domainFrom: 0 to: data size;		rangeFrom: 10 to: 30.	chart := GtPlotterHorizontalBarChart new.	chart		withAdjacentBars;		groupSpacing: 5;		barLabelSpacing: 55;		barWidthScale: widthScale;		barWidthData: [ :each | each third size ];		barHeightScale: heightScale;		barHeightData: [ :eachGroup | eachGroup size ];		amountOfTicks: 4;		barGroupStencil: [ :aBar :aGroup :aContext |			(aBar stencil scaleContext: aContext) asElement				constraintsDo: [ :c |					c horizontal matchParent.					c vertical exact: (aBar heightScale map: (aBar heightData cull: aGroup)) ];				when: BlClickEvent do: [ :anEvent |					anEvent consumed: true.					anEvent currentTarget phlow						spawnObject: (self paperGroupFromPlotterDataEntity: aContext originalValue) ];				geometry: (BlHistogramGeometry new beLeftToRight values: aContext mappedValue);				background: aGroup color ];		with: data.	^ chart! !!VSStudy methodsFor: 'charting' stamp: '9/2/2026 15:00'!paperGroupFromPlotterDataEntity: aDataEntity	"Extract the paper group from a plotter group, removing its presentation decorators."	^ aDataEntity decoratedEntity values first third! !!VSStudy methodsFor: 'querying' stamp: '9/2/2026 15:00'!papersInYear: aYear selectedOnly: aBoolean	| papers |	papers := allPapers values select: [ :each |		(each record at: 'Paper Year') = aYear asString ].	aBoolean ifTrue: [		papers := papers select: [ :each | each selectedRecord notNil ] ].	^ VSPaperGroup withAll: papers! !!VSStudy methodsFor: 'searching' stamp: '9/2/2026 15:00'!papersMatchingTitle: aQueryString	| query |	query := aQueryString asLowercase.	^ VSPaperGroup withAll: ((allPapers values select: [ :aPaper |		(aPaper record at: 'Title') asLowercase includesSubstring: query ])		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])! !Object subclass: #VSTopic	instanceVariableNames: 'name papers'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSTopic methodsFor: 'adding' stamp: '9/2/2026 15:00'!addPaper: aVSPaper	papers addIfNotPresent: aVSPaper! !!VSTopic methodsFor: 'initialization' stamp: '9/2/2026 15:00'!initialize	super initialize.	papers := OrderedCollection new! !!VSTopic methodsFor: 'accessing' stamp: '9/2/2026 15:00'!name	^ name! !!VSTopic methodsFor: 'accessing' stamp: '9/2/2026 15:00'!name: aString	name := aString! !!VSTopic methodsFor: 'accessing' stamp: '9/2/2026 15:00'!papers	^ papers! !!VSTopic methodsFor: 'printing' stamp: '9/2/2026 15:00'!printOn: aStream	aStream nextPutAll: self name! !Object subclass: #VSAuthor	instanceVariableNames: 'name papers'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSAuthor commentStamp: '' prior: 0!An author participating in one or more papers in a visual software study.!!VSAuthor methodsFor: 'adding' stamp: '9/2/2026 15:00'!addPaper: aVSPaper	papers addIfNotPresent: aVSPaper! !!VSAuthor methodsFor: 'graphing' stamp: '9/2/2026 15:00'!authorPaperGraphIn: aMondrian papers: papers authors: authors	"Render a paper-author graph, emphasizing this author as its starting node."	(VSPaperGroup withAll: papers)		renderAuthorPaperGraphIn: aMondrian		papers: papers		authors: authors		nodeStencil: [ :aModel | self authorPaperNodeFor: aModel ]! !!VSAuthor methodsFor: 'graphing' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraphIn: aMondrian	"Visualize the complete paper-author connected component containing this author without modifying its paper collection."	| reachablePapers reachableAuthors pendingPapers aReachablePaper |	reachablePapers := self papers asIdentitySet.	reachableAuthors := IdentitySet with: self.	pendingPapers := self papers copy asOrderedCollection.	[ pendingPapers isEmpty ] whileFalse: [		aReachablePaper := pendingPapers removeFirst.		aReachablePaper authors do: [ :anAuthor |			reachableAuthors add: anAuthor.			anAuthor papers do: [ :anotherPaper |				(reachablePapers includes: anotherPaper) ifFalse: [					reachablePapers add: anotherPaper.					pendingPapers add: anotherPaper ] ] ] ].	self authorPaperGraphIn: aMondrian papers: reachablePapers authors: reachableAuthors! !!VSAuthor methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!authorPaperNodeFor: aModel	| isAuthor size tooltipText element |	isAuthor := aModel isKindOf: VSAuthor.	size := isAuthor		ifTrue: [ 25 + (aModel papers size * 8) ]		ifFalse: [ 25 + (aModel authors size * 8) ].	tooltipText := isAuthor		ifTrue: [ aModel name ]		ifFalse: [ aModel record at: 'Title' ].	element := BlElement new		background: (isAuthor			ifTrue: [ aModel == self ifTrue: [ Color lightBlue darker ] ifFalse: [ Color lightBlue ] ]			ifFalse: [ Color paleRed ]);		geometry: (isAuthor			ifTrue: [ BlRectangleGeometry new ]			ifFalse: [ BlEllipseGeometry new ]);		size: size @ size;		addAptitude: (BrGlamorousWithLabelTooltipAptitude text: tooltipText);		when: BlClickEvent do: [ :anEvent | anEvent currentTarget phlow spawnObject: aModel ];		yourself.	isAuthor ifTrue: [		element			layout: BlFrameLayout new;			addChild: (BlTextElement new				text: (self initialsFor: aModel) asRopedText;				constraintsDo: [ :aConstraints |					aConstraints frame horizontal alignCenter.					aConstraints frame vertical alignCenter ]) ]	ifFalse: [ aModel isDesignStudy ifTrue: [ element border: (BlBorder paint: Color red width: 2) ] ].	^ element! !!VSAuthor methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!gtReachableAuthorPaperGraphFor: aView	<gtView>	^ aView mondrian		title: 'Reachable author papers graph';		priority: 51;		painting: [ :aMondrian | self reachableAuthorPaperGraphIn: aMondrian ];		actionUpdateButton! !!VSAuthor methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtPapersFor: aView	<gtView>	^ aView columnedList		title: 'Papers';		items: [ (self papers			sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSAuthor methodsFor: 'initialization' stamp: '9/2/2026 15:00'!initialize	super initialize.	papers := OrderedCollection new! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:00'!initialsFor: anAuthor	"Answer available given-name and surname initials for a name formatted as 'Surname, Given names'."	| nameParts surname givenNames givenLetters surnameLetters |	nameParts := anAuthor name substrings: ','.	surname := nameParts first ifNil: [ '' ].	givenNames := nameParts allButFirst joinUsing: ' '.	givenLetters := givenNames select: #isLetter.	surnameLetters := surname select: #isLetter.	^ (givenLetters		ifEmpty: [ '' ]		ifNotEmpty: [ givenLetters first asString ])		, (surnameLetters			ifEmpty: [ '' ]			ifNotEmpty: [ surnameLetters first asString ])! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:00'!name	^ name! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:00'!name: aString	name := aString! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:00'!papers	^ papers! !!VSAuthor methodsFor: 'printing' stamp: '9/2/2026 15:00'!printOn: aStream	aStream nextPutAll: self name! !Object subclass: #VSPaper	instanceVariableNames: 'record study selectedRecord'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!authorNames	| authorKeys |	authorKeys := #(		'First Author'		'Second Author'		'Third Author'		'Fourth Author'		'Fifth Author'		'Sixth Author'		'Seven Author'		'Eighth Author'		'Nineth Author'		'Tenth Author'		'Eleventh Author'		'Twelfth Author').	^ (authorKeys collect: [ :aKey |		(record at: aKey ifAbsent: [ '' ]) copyWithout: $" ])		collect: [ :aName | aName trimBoth ]		thenSelect: [ :aName | aName isNotEmpty ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!authors	^ self authorNames collect: [ :eachName | study authorNamed: eachName ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!googleScholarSearchUrl	^ 'https://scholar.google.com/scholar?hl=en&q=' , (record at: 'Title') urlEncoded! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!id	^ record at: 'ID'! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!record	^ record! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!record: aDictionary	record := aDictionary! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!selectedRecord	^ selectedRecord! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!selectedRecord: aDictionary	selectedRecord := aDictionary! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!study	^ study! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!study: aVSStudy	study := aVSStudy! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!title	"Answer the paper title from the source record."	^ record at: 'Title' ifAbsent: [ '' ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!topic	^ self topicName		ifNil: [ nil ]		ifNotNil: [ :aName | study topicNamed: aName ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:00'!topicName	^ selectedRecord		ifNil: [ nil ]		ifNotNil: [ selectedRecord at: 'Topic' ifAbsent: [ nil ] ]! !!VSPaper methodsFor: 'graphing' stamp: '9/2/2026 15:00'!authorPaperGraphIn: aMondrian papers: papers authors: authors startingPaper: aStartingPaper connectStartingPaper: shouldConnectStartingPaper	"Render a paper-author graph using the supplied paper and author collections."	shouldConnectStartingPaper ifTrue: [		aMondrian edges			connect: authors			from: [ :anAuthor | self ]			to: [ :anAuthor | anAuthor ] ].	(VSPaperGroup withAll: papers)		renderAuthorPaperGraphIn: aMondrian		papers: papers		authors: authors		nodeStencil: [ :aModel | self authorPaperNodeFor: aModel startingPaper: aStartingPaper ]! !!VSPaper methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!authorPaperNodeFor: aModel	^ self authorPaperNodeFor: aModel startingPaper: nil! !!VSPaper methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!authorPaperNodeFor: aModel startingPaper: aStartingPaper	| size element tooltipText isAuthor isStartingPaper |	isAuthor := aModel isKindOf: VSAuthor.	isStartingPaper := aModel == aStartingPaper.	size := isAuthor		ifTrue: [ 25 + (aModel papers size * 8) ]		ifFalse: [ 25 + (aModel authors size * 8) ].	tooltipText := isAuthor		ifTrue: [ aModel name ]		ifFalse: [ aModel record at: 'Title' ].	element := BlElement new		background: (isAuthor			ifTrue: [ Color lightBlue ]			ifFalse: [ isStartingPaper ifTrue: [ Color paleRed darker ] ifFalse: [ Color paleRed ] ]);		geometry: (isAuthor			ifTrue: [ BlRectangleGeometry new ]			ifFalse: [ BlEllipseGeometry new ]);		size: size @ size;		addAptitude: (BrGlamorousWithLabelTooltipAptitude text: tooltipText);		when: BlClickEvent do: [ :anEvent | anEvent currentTarget phlow spawnObject: aModel ];		yourself.	(aModel isKindOf: VSPaper) ifTrue: [		aModel isDesignStudy ifTrue: [			element border: (BlBorder paint: Color red width: 2) ] ].	isAuthor ifTrue: [		element			layout: BlFrameLayout new;			addChild: (BlTextElement new				text: (self initialsForAuthor: aModel) asRopedText;				constraintsDo: [ :aConstraints |					aConstraints frame horizontal alignCenter.					aConstraints frame vertical alignCenter ]) ].	^ element! !!VSPaper methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!gtReachableAuthorPaperGraphFor: aView	<gtView>	^ aView mondrian		title: 'Reachable author papers graph';		priority: 11;		painting: [ :aMondrian | self reachableAuthorPaperGraphIn: aMondrian ];		actionUpdateButton! !!VSPaper methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!reachableAuthorPaperGraphIn: aMondrian	"Visualize the complete paper-author connected component containing this paper."	| component |	component := self reachablePaperAuthorComponent.	self		authorPaperGraphIn: aMondrian		papers: component key		authors: component value		startingPaper: self		connectStartingPaper: false! !!VSPaper methodsFor: 'visualizing' stamp: '9/2/2026 15:00'!reachablePaperAuthorComponent	"Answer papers -> authors in the connected paper-author component containing this paper."	| papers authors pendingPapers aPaper |	papers := IdentitySet with: self.	authors := IdentitySet new.	pendingPapers := OrderedCollection with: self.	[ pendingPapers isEmpty ] whileFalse: [		aPaper := pendingPapers removeFirst.		aPaper authors do: [ :anAuthor |			authors add: anAuthor.			anAuthor papers do: [ :anotherPaper |				(papers includes: anotherPaper) ifFalse: [					papers add: anotherPaper.					pendingPapers add: anotherPaper ] ] ] ].	^ papers -> authors! !!VSPaper methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtAuthorsFor: aView	<gtView>	^ aView columnedList		title: 'Authors';		priority: 1;		items: [ self authors ];		column: 'Author' text: [ :anAuthor | anAuthor name ] weight: 2;		column: '# of papers' text: [ :anAuthor | anAuthor papers size ] weight: 0.6;		send: [ :anAuthor | anAuthor ];		actionUpdateButton! !!VSPaper methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtStudyDetailsFor: aView	<gtView>	selectedRecord ifNil: [ ^ aView empty ].	^ aView columnedList		title: 'Study Details';		priority: 3;		items: [ selectedRecord associations sorted: [ :left :right | left key <= right key ] ];		column: 'Attribute' text: [ :anAssociation | anAssociation key ] weight: 1;		column: 'Value' text: [ :anAssociation | anAssociation value ] weight: 4;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSPaper methodsFor: 'gt views' stamp: '9/2/2026 15:00'!gtSummaryFor: aView	<gtView>	^ aView columnedList		title: 'Summary';		priority: 2;		items: [			| authorKeys otherKeys orderedKeys |			authorKeys := #('First Author' 'Second Author' 'Third Author' 'Fourth Author' 'Fifth Author' 'Sixth Author' 'Seven Author' 'Eighth Author' 'Nineth Author' 'Tenth Author' 'Eleventh Author' 'Twelfth Author').			otherKeys := record keys reject: [ :aKey |				(aKey allSatisfy: [ :aCharacter | aCharacter isDigit ])					or: [ aKey = 'Title' or: [ authorKeys includes: aKey ] ] ].			orderedKeys := { 'Title' }, (authorKeys select: [ :aKey | record includesKey: aKey ]), otherKeys asSortedCollection.			orderedKeys collect: [ :aKey | aKey -> (record at: aKey) ] ];		column: 'Attribute' text: [ :anAssociation | anAssociation key ] weight: 1;		column: 'Value' text: [ :anAssociation | anAssociation value ] weight: 4;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSPaper methodsFor: 'gt-actions' stamp: '9/2/2026 15:00'!gtGoogleScholarSearchFor: anAction	<gtAction>	^ anAction button		icon: BrGlamorousVectorIcons web;		tooltip: 'Search title in Google Scholar';		action: [ :aButton | WebBrowser openOn: self googleScholarSearchUrl ]! !!VSPaper methodsFor: 'visualization' stamp: '9/2/2026 15:00'!initialsForAuthor: anAuthor	"Answer the first letter of the given name followed by the first letter of the surname, without periods."	| nameParts surname givenNames givenInitial surnameInitial |	nameParts := anAuthor name substrings: ','.	surname := nameParts first trimBoth.	givenNames := nameParts allButFirst joinUsing: ' '.	givenInitial := (givenNames select: #isLetter) first asString.	surnameInitial := (surname select: #isLetter) first asString.	^ givenInitial , surnameInitial! !!VSPaper methodsFor: 'testing' stamp: '9/2/2026 15:00'!isDesignStudy	^ (record at: 'Type' ifAbsent: [ nil ]) = 'Design Study'! !!VSPaper methodsFor: 'printing' stamp: '9/2/2026 15:00'!printOn: aStream	aStream nextPutAll: (record at: 'Title')! !Object subclass: #VSPaperGroup	uses: TGtGroupWithItems	instanceVariableNames: 'items'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSPaperGroup commentStamp: '' prior: 0!A moldable collection wrapper for papers in a visualization study.!!VSPaperGroup methodsFor: 'gt-views' stamp: '9/2/2026 15:05'!gtPaperGroupsByYearFor: aView
	<gtView>
	^ aView columnedList
		title: 'Paper groups by year';
		priority: 1.1;
		items: [
			(self groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) associations
				sorted: [ :anAssociation :anotherAssociation | anAssociation key < anotherAssociation key ] ];
		column: 'Year' text: [ :anAssociation | anAssociation key ];
		column: '# of papers' text: [ :anAssociation | anAssociation value size ];
			send: [ :anAssociation | anAssociation value ];
